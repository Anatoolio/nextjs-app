model Ingredient {
  id          String   @id @default(uuid())
  name        String
  category    Category
  unit        Unit
  pricePerUnit Float?
  description String? 
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // recipes Recipe[] @relation("RecipeIngredients")

  @@map("ingredients")
}
 